#!/bin/bash
# Open the Attack Shark R85HE configurator: Linux driver on :3814 + app UI on :38140.
cd "$(dirname "$(readlink -f "$0")")"
ss -ltn | grep -q '127.0.0.1:3814 ' || (cd driver && setsid node dist/server-node.js >/tmp/r85he-driver.log 2>&1 < /dev/null &)
ss -ltn | grep -q '127.0.0.1:38140 ' || setsid python3 -m http.server 38140 --bind 127.0.0.1 --directory app/dist >/dev/null 2>&1 < /dev/null &
sleep 1
xdg-open http://127.0.0.1:38140/ >/dev/null 2>&1
